# Copy to .env, fill locally. Never commit .env.
# Values starting with replace_with_ are rejected at startup until filled.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Positive numeric Telegram IDs, comma separated without spaces.
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_SUPERADMIN_IDS=123456789
# Optional team archive channel: full negative Bot API chat_id, e.g. -1001234567890.
# Empty disables channel publications for newly approved broadcasts.
TELEGRAM_TEAM_CHANNEL_ID=
# Ordinary admins may review user applications / export the Excel user base.
ADMINS_CAN_APPROVE_USERS=false
ADMINS_CAN_EXPORT_USERS=false
# DeepL API Free: https://api-free.deepl.com ; Pro: https://api.deepl.com
TRANSLATOR_API_KEY=
TRANSLATOR_API_URL=https://api-free.deepl.com
# Docker Compose overrides this with /data/broadcast.sqlite.
DATABASE_PATH=./var/broadcast.sqlite
# production: secured SMTP only (starttls or tls) with credentials.
# test: also allows SMTP_ENCRYPTION=none with empty credentials (local receiver).
APP_ENV=production
# smtp (default: Mailtrap/Mailpit/other SMTP) or gmail (OAuth Gmail API).
MAIL_TRANSPORT=smtp
# Gmail mode does not require SMTP credentials. Paths are read from env.
# Compose Gmail override mounts these JSON files read-only; see docs/GMAIL.md.
GMAIL_OAUTH_CLIENT_FILE=./secrets/gmail-client.json
GMAIL_OAUTH_TOKEN_FILE=./secrets/gmail-token.json
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM_ADDRESS=replace_with_from_address
MAIL_FROM_NAME=
MAIL_REPLY_TO=
# Pause between individual emails in seconds (1-86400).
MAIL_SEND_INTERVAL_SECONDS=2
